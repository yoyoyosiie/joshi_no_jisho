{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "term.schema.json",
  "title": "Term",
  "description": "One dictionary entry: data/terms/tNNNNNN.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ja", "reading", "senses", "sources", "added", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^t[0-9]{6}$", "description": "Stable id, same as the file name. Never reuse one."},
    "ja": {"type": "string", "minLength": 1, "description": "Headword as usually written."},
    "alt": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Other spellings."},
    "reading": {
      "type": "string",
      "pattern": "^[ぁ-ゖァ-ヺーゝゞヽヾ・A-Za-z0-9]+$",
      "description": "Kana (Latin letters/digits allowed for parts like 'NC'). Romaji is derived at build, never stored."
    },
    "furigana": {
      "description": "Headword split into [text, reading] pairs; kana-only parts are [text]. Joined text must equal `ja`.",
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}}}
      ]
    },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "verified"],
      "properties": {
        "value": {"type": ["integer", "null"], "minimum": 0, "description": "Downstep position (0 = heiban)."},
        "source": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      }
    },
    "senses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sense"}},
    "card_sentence": {"type": ["string", "null"], "pattern": "^s[0-9]{6}$", "description": "Sentence for the Anki card. Default: the first linked sentence."},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "credit", "license"],
        "properties": {"file": {"type": "string"}, "credit": {"type": "string"}, "license": {"type": "string"}}
      }
    },
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Where the term was found, e.g. a patent number."},
    "added": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"enum": ["draft", "reviewed"], "description": "Only reviewed terms show on the site by default."}
  },
  "$defs": {
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pos", "en"],
      "properties": {
        "pos": {"enum": ["noun", "suru-noun", "verb", "i-adj", "na-adj", "adverb", "expression", "prefix", "suffix", "counter", "other"]},
        "en": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "English glosses. May be empty while the term is a draft."},
        "en_by": {"enum": ["human", "jmdict", "machine", null], "description": "Who wrote the glosses."},
        "def_en": {"type": ["string", "null"]},
        "def_ja": {"type": ["string", "null"]},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "Ids from data/tags.yaml."}
      }
    }
  }
}
