---
// The bare address (/joshi_no_jisho/) sends readers to /en/ or /ja/:
// the language they picked last time, otherwise their browser's language.
import { url } from "../lib/dict";
---
<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ジョシの辞書</title>
    <script is:inline define:vars={{ en: url("en/"), ja: url("ja/") }}>
      let lang = null;
      try { lang = JSON.parse(localStorage.getItem("jisho.lang")); } catch {}
      if (!lang) lang = (navigator.language || "").startsWith("ja") ? "ja" : "en";
      location.replace(lang === "ja" ? ja : en);
    </script>
  </head>
  <body>
    <p><a href={url("en/")}>English</a> · <a href={url("ja/")}>日本語</a></p>
  </body>
</html>
